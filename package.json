{
  "name": "ai-powered-hrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:mock": "node scripts/export-mock-json.mjs",
    "mock:web": "node scripts/export-mock-json.mjs",
    "css:web": "tailwindcss -c tailwind.web.config.mjs -i ./web/assets/css/tailwind.input.css -o ./web/assets/css/tailwind.css",
    "css:web:watch": "tailwindcss -c tailwind.web.config.mjs -i ./web/assets/css/tailwind.input.css -o ./web/assets/css/tailwind.css --watch",
    "predev": "node scripts/export-mock-json.mjs",
    "dev": "next dev",
    "dev:web": "node scripts/serve-web.mjs",
    "prebuild": "node scripts/export-mock-json.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/test-hrm.mjs",
    "test:workflows": "node scripts/test-recruitment-workflows.mjs",
    "test": "node scripts/test-hrm.mjs && node scripts/test-recruitment-workflows.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
