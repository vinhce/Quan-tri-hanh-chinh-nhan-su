{
  "name": "ai-powered-hrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:mock": "node scripts/export-mock-json.mjs",
    "mock:web": "node scripts/export-mock-json.mjs",
    "css:web": "tailwindcss -c tailwind.web.config.mjs -i ./web/assets/css/tailwind.input.css -o ./web/assets/css/tailwind.css",
    "css:web:watch": "tailwindcss -c tailwind.web.config.mjs -i ./web/assets/css/tailwind.input.css -o ./web/assets/css/tailwind.css --watch",
    "reset:demo": "node scripts/reset-demo-data.mjs",
    "ai:wake": "node scripts/wake-copilot-space.mjs",
    "dev": "node scripts/dev-all.mjs",
    "dev:3005": "node scripts/reset-demo-data.mjs && next dev -p 3005",
    "dev:web": "node scripts/serve-web.mjs",
    "prebuild": "node scripts/export-mock-json.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/test-hrm.mjs",
    "test:recruitment": "node scripts/test-recruitment-workflows.mjs",
    "test:all-workflows": "node scripts/test-all-system-workflows.mjs",
    "test:lifecycle": "node scripts/test-employee-lifecycle.mjs",
    "test:biometric": "node scripts/test-biometric-wifi.mjs",
    "periocular:start": "powershell -ExecutionPolicy Bypass -File scripts/start-periocular-service.ps1",
    "test": "node scripts/test-hrm.mjs && node scripts/test-recruitment-workflows.mjs && node scripts/test-all-system-workflows.mjs && node scripts/test-employee-lifecycle.mjs && node scripts/test-biometric-wifi.mjs"
  },
  "dependencies": {
    "@vladmandic/human": "^3.3.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
